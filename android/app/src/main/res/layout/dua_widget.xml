<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Label -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_dua_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="DAILY REMEMBRANCE"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="Salah Companion"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </RelativeLayout>

    <!-- Arabic Text -->
    <TextView
        android:id="@+id/widget_dua_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ، سُبْحَانَ اللَّهِ الْعَظِيمِ"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- English Translation Snippet -->
    <TextView
        android:id="@+id/widget_dua_translation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Glory be to Allah and His is the praise, Glory be to Allah the Most Great."
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="center" />

</LinearLayout>
